{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dynamos.example/schema/research-contribution-1.0.0.json",
  "title": "DYNAMOS research contribution",
  "description": "Strict privacy-minimized record for voluntary donation of a DYNAMOS result. No identity, contact details, free text, diagnostics, employer, location, device data, or analytics identifiers are permitted.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "schema_version",
    "submission_id",
    "withdrawal_token_hash",
    "model_version",
    "questionnaire_version",
    "derivation_version",
    "consent_version",
    "scope",
    "scores",
    "presented_precepta",
    "participant_feedback",
    "consent"
  ],
  "properties": {
    "schema": {
      "const": "dynamos-research-contribution"
    },
    "schema_version": {
      "const": "1.0.0"
    },
    "submission_id": {
      "type": "string",
      "format": "uuid",
      "description": "Random per-result idempotency identifier. It is not an account or person identifier."
    },
    "withdrawal_token_hash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$",
      "description": "SHA-256 hash of a random withdrawal token generated locally. The plaintext token is retained by the participant, not stored in the research record."
    },
    "model_version": {
      "type": "string",
      "minLength": 1,
      "maxLength": 32
    },
    "questionnaire_version": {
      "type": "string",
      "minLength": 1,
      "maxLength": 32
    },
    "derivation_version": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64
    },
    "consent_version": {
      "type": "string",
      "minLength": 1,
      "maxLength": 32
    },
    "scope": {
      "type": "array",
      "minItems": 1,
      "maxItems": 5,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "enum": [
          "cognitive_learning",
          "attention_activation_work_rhythm",
          "social_communication",
          "emotional_self_regulation",
          "sensory_physical"
        ]
      }
    },
    "scores": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ET",
        "MR",
        "XS",
        "RC",
        "IG",
        "MI",
        "SF",
        "BC",
        "CD",
        "PH",
        "RS",
        "PA",
        "TD",
        "DHL",
        "RD",
        "CC",
        "CL-social",
        "CL-cognitive",
        "CL-sensory",
        "CL-affective",
        "FB-S",
        "FB-I",
        "IC-C",
        "IC-A",
        "RSu",
        "CG"
      ],
      "properties": {
        "ET": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10
        },
        "MR": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10
        },
        "XS": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10
        },
        "RC": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10
        },
        "IG": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10
        },
        "MI": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10
        },
        "SF": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10
        },
        "BC": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10
        },
        "CD": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10
        },
        "PH": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10
        },
        "RS": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10
        },
        "PA": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10
        },
        "TD": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10
        },
        "DHL": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10
        },
        "RD": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10
        },
        "CC": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10
        },
        "CL-social": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10
        },
        "CL-cognitive": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10
        },
        "CL-sensory": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10
        },
        "CL-affective": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10
        },
        "FB-S": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10
        },
        "FB-I": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10
        },
        "IC-C": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10
        },
        "IC-A": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10
        },
        "RSu": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10
        },
        "CG": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10
        }
      }
    },
    "presented_precepta": {
      "type": "array",
      "minItems": 0,
      "maxItems": 32,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "pattern_id",
          "presentation_status",
          "rank"
        ],
        "properties": {
          "pattern_id": {
            "type": "string",
            "enum": [
              "deep_systems_architect",
              "precision_resolver",
              "fast_insight_slow_explanation",
              "divergent_idea_generator",
              "domain_locked_expert",
              "split_integration_thinker",
              "big_picture_synthesizer",
              "executive_load_taxed",
              "flow_diver",
              "meaning_gated_performer",
              "burst_creator",
              "routine_anchor",
              "deadline_unlocked_starter",
              "long_horizon_planner",
              "transition_fragile",
              "start_stop_oscillator",
              "precision_literalist",
              "social_cue_load",
              "low_feedback_autonomy",
              "impulsive_enthusiastic_communicator",
              "masked_high_cost_performer",
              "ethical_precision_speaker",
              "affective_floodgate",
              "social_rejection_amplifier",
              "ethical_amplifier",
              "verification_loop",
              "affective_decoupler",
              "open_plan_vulnerable",
              "sensory_seeking_stabilizer",
              "quiet_need_deep_worker",
              "stim_regulation_loop",
              "time_blind_sprinter"
            ]
          },
          "presentation_status": {
            "type": "string",
            "enum": [
              "strong",
              "candidate",
              "context_sensitive"
            ]
          },
          "rank": {
            "type": "integer",
            "minimum": 1,
            "maximum": 32
          }
        }
      }
    },
    "participant_feedback": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "overall_fit",
        "pattern_recognition",
        "missing_pattern_feedback"
      ],
      "properties": {
        "overall_fit": {
          "type": [
            "string",
            "null"
          ],
          "enum": [
            "strongly_recognize",
            "mostly_recognize",
            "partly_recognize",
            "do_not_recognize",
            "do_not_understand",
            null
          ]
        },
        "pattern_recognition": {
          "type": "array",
          "maxItems": 32,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "pattern_id",
              "response"
            ],
            "properties": {
              "pattern_id": {
                "type": "string",
                "enum": [
                  "deep_systems_architect",
                  "precision_resolver",
                  "fast_insight_slow_explanation",
                  "divergent_idea_generator",
                  "domain_locked_expert",
                  "split_integration_thinker",
                  "big_picture_synthesizer",
                  "executive_load_taxed",
                  "flow_diver",
                  "meaning_gated_performer",
                  "burst_creator",
                  "routine_anchor",
                  "deadline_unlocked_starter",
                  "long_horizon_planner",
                  "transition_fragile",
                  "start_stop_oscillator",
                  "precision_literalist",
                  "social_cue_load",
                  "low_feedback_autonomy",
                  "impulsive_enthusiastic_communicator",
                  "masked_high_cost_performer",
                  "ethical_precision_speaker",
                  "affective_floodgate",
                  "social_rejection_amplifier",
                  "ethical_amplifier",
                  "verification_loop",
                  "affective_decoupler",
                  "open_plan_vulnerable",
                  "sensory_seeking_stabilizer",
                  "quiet_need_deep_worker",
                  "stim_regulation_loop",
                  "time_blind_sprinter"
                ]
              },
              "response": {
                "type": "string",
                "enum": [
                  "strongly_recognize",
                  "mostly_recognize",
                  "partly_recognize",
                  "do_not_recognize",
                  "do_not_understand"
                ]
              }
            }
          }
        },
        "missing_pattern_feedback": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "important_part_missing",
            "selected_patterns",
            "followups"
          ],
          "properties": {
            "important_part_missing": {
              "type": [
                "string",
                "null"
              ],
              "enum": [
                "yes",
                "no",
                "unsure",
                null
              ]
            },
            "selected_patterns": {
              "type": "array",
              "maxItems": 3,
              "uniqueItems": true,
              "items": {
                "type": "string",
                "enum": [
                  "deep_systems_architect",
                  "precision_resolver",
                  "fast_insight_slow_explanation",
                  "divergent_idea_generator",
                  "domain_locked_expert",
                  "split_integration_thinker",
                  "big_picture_synthesizer",
                  "executive_load_taxed",
                  "flow_diver",
                  "meaning_gated_performer",
                  "burst_creator",
                  "routine_anchor",
                  "deadline_unlocked_starter",
                  "long_horizon_planner",
                  "transition_fragile",
                  "start_stop_oscillator",
                  "precision_literalist",
                  "social_cue_load",
                  "low_feedback_autonomy",
                  "impulsive_enthusiastic_communicator",
                  "masked_high_cost_performer",
                  "ethical_precision_speaker",
                  "affective_floodgate",
                  "social_rejection_amplifier",
                  "ethical_amplifier",
                  "verification_loop",
                  "affective_decoupler",
                  "open_plan_vulnerable",
                  "sensory_seeking_stabilizer",
                  "quiet_need_deep_worker",
                  "stim_regulation_loop",
                  "time_blind_sprinter"
                ]
              }
            },
            "followups": {
              "type": "array",
              "maxItems": 3,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "pattern_id",
                  "question_id",
                  "response"
                ],
                "properties": {
                  "pattern_id": {
                    "type": "string",
                    "enum": [
                      "deep_systems_architect",
                      "precision_resolver",
                      "fast_insight_slow_explanation",
                      "divergent_idea_generator",
                      "domain_locked_expert",
                      "split_integration_thinker",
                      "big_picture_synthesizer",
                      "executive_load_taxed",
                      "flow_diver",
                      "meaning_gated_performer",
                      "burst_creator",
                      "routine_anchor",
                      "deadline_unlocked_starter",
                      "long_horizon_planner",
                      "transition_fragile",
                      "start_stop_oscillator",
                      "precision_literalist",
                      "social_cue_load",
                      "low_feedback_autonomy",
                      "impulsive_enthusiastic_communicator",
                      "masked_high_cost_performer",
                      "ethical_precision_speaker",
                      "affective_floodgate",
                      "social_rejection_amplifier",
                      "ethical_amplifier",
                      "verification_loop",
                      "affective_decoupler",
                      "open_plan_vulnerable",
                      "sensory_seeking_stabilizer",
                      "quiet_need_deep_worker",
                      "stim_regulation_loop",
                      "time_blind_sprinter"
                    ]
                  },
                  "question_id": {
                    "type": "string",
                    "pattern": "^[a-z0-9_\\-]{1,64}$"
                  },
                  "response": {
                    "type": "string",
                    "enum": [
                      "strongly_agree",
                      "mostly_agree",
                      "partly_agree",
                      "disagree",
                      "unsure"
                    ]
                  }
                }
              }
            }
          }
        }
      }
    },
    "consent": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "voluntary_contribution",
        "understands_exploratory_status",
        "understands_no_identity_requested",
        "understands_aggregate_publication",
        "understands_withdrawal_token"
      ],
      "properties": {
        "voluntary_contribution": {
          "const": true
        },
        "understands_exploratory_status": {
          "const": true
        },
        "understands_no_identity_requested": {
          "const": true
        },
        "understands_aggregate_publication": {
          "const": true
        },
        "understands_withdrawal_token": {
          "const": true
        }
      }
    }
  }
}
