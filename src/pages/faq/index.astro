    <style>
      .faq-hero { padding: 7rem 2rem 4.5rem; }

      .faq-core {
        max-width: 920px;
        margin-top: 2.5rem;
        padding: 1.35rem 1.5rem;
        border-left: 4px solid currentColor;
        font-size: 1.06rem;
      }

      .faq-map {
        display: flex;
        flex-wrap: wrap;
        gap: 0.65rem;
        padding: 0 2rem 4rem;
      }

      .faq-map a {
        padding: 0.58rem 0.78rem;
        border: 1px solid #b9b6ad;
        border-radius: 999px;
        text-decoration: none;
        font-size: 0.86rem;
      }

      .faq-section {
        display: grid;
        grid-template-columns: minmax(220px, 0.72fr) minmax(0, 1.6fr);
        gap: 4rem;
        padding: 5rem 2rem;
        border-top: 1px solid #b9b6ad;
      }

      .faq-section-heading {
        position: sticky;
        top: 1.5rem;
        align-self: start;
      }

      .faq-section-heading h2 {
        max-width: 520px;
        margin-bottom: 0;
      }

      .faq-list { border-top: 1px solid #b9b6ad; }

      .faq-list details { border-bottom: 1px solid #b9b6ad; }

      .faq-list summary {
        cursor: pointer;
        list-style: none;
        padding: 1.25rem 2.2rem 1.25rem 0;
        font-size: 1.15rem;
        font-weight: 750;
        position: relative;
      }

      .faq-list summary::-webkit-details-marker { display: none; }

      .faq-list summary::after {
        content: '+';
        position: absolute;
        right: 0.2rem;
        top: 1.1rem;
        font-size: 1.45rem;
        font-weight: 400;
      }

      .faq-list details[open] summary::after { content: '–'; }

      .faq-answer {
        max-width: 850px;
        padding: 0 0 1.8rem;
      }

      .faq-answer p:first-child { margin-top: 0; }

      .faq-answer blockquote,
      .faq-final blockquote {
        margin: 1.5rem 0;
        padding-left: 1.2rem;
        border-left: 3px solid currentColor;
        font-size: 1.15rem;
        line-height: 1.5;
      }

      .concept-flow {
        display: grid;
        grid-template-columns: 1fr auto 1fr auto 1fr auto 1fr;
        gap: 0.75rem;
        align-items: center;
        margin: 1.7rem 0;
        font-size: 0.92rem;
      }

      .concept-flow span {
        padding: 0.85rem;
        border: 1px solid #b9b6ad;
        border-radius: 0.6rem;
      }

      .comparison-table-wrap {
        overflow-x: auto;
        margin: 1.5rem 0;
      }

      .comparison-table-wrap table {
        width: 100%;
        border-collapse: collapse;
        min-width: 720px;
      }

      .comparison-table-wrap th,
      .comparison-table-wrap td {
        text-align: left;
        vertical-align: top;
        padding: 0.85rem 0.75rem;
        border-bottom: 1px solid #d2cfc6;
      }

      .comparison-table-wrap th {
        font-size: 0.82rem;
        letter-spacing: 0.02em;
      }

      .faq-note { font-size: 0.9rem; }

      .next-grid {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 0.8rem;
      }

      .next-grid a {
        display: grid;
        gap: 0.25rem;
        padding: 1rem;
        border: 1px solid #b9b6ad;
        border-radius: 0.65rem;
        text-decoration: none;
      }

      .next-grid span { font-size: 0.86rem; }

      .faq-final {
        padding: 5rem 2rem 6rem;
        border-top: 1px solid #b9b6ad;
      }

      .faq-final blockquote {
        max-width: 980px;
        font-size: clamp(1.4rem, 3vw, 2.3rem);
      }

      .faq-final-links {
        display: flex;
        gap: 1rem 1.5rem;
        flex-wrap: wrap;
        align-items: center;
        margin-top: 2rem;
      }

      .primary-link {
        display: inline-block;
        padding: 0.8rem 1rem;
        border: 1px solid #17202a;
        border-radius: 0.55rem;
        background: #17202a;
        color: #f7f5ef;
        text-decoration: none;
        font-weight: 750;
      }

      @media (max-width: 900px) {
        .faq-section { grid-template-columns: 1fr; gap: 2rem; }
        .faq-section-heading { position: static; }
        .concept-flow { grid-template-columns: 1fr; }
        .concept-flow b { text-align: center; }
      }

      @media (max-width: 620px) {
        .faq-hero { padding-top: 4rem; }
        .next-grid { grid-template-columns: 1fr; }
      }
    </style>
  </body>
</html>
