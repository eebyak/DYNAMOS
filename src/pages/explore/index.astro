        width: 100%;
        height: 0.55rem;
        accent-color: #17202a;
      }

      .scale-reference {
        display: grid;
        grid-template-columns: repeat(5, 1fr);
        border-top: 1px solid #b9b6ad;
        border-bottom: 1px solid #b9b6ad;
        margin-bottom: 4rem;
      }

      .scale-reference div {
        padding: 1rem 1rem 1rem 0;
        display: grid;
        gap: 0.2rem;
      }

