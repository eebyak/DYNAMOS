        flex-wrap: wrap;
      }

      button { font: inherit; }

      .primary-button,
      .secondary-button {
        min-height: 44px;
        padding: 0.72rem 1rem;
        border-radius: 0.55rem;
        cursor: pointer;
        font-weight: 750;
      }

      .primary-button {
        border: 1px solid #17202a;
        background: #17202a;
        color: #f7f5ef;
      }

      .secondary-button {
        border: 1px solid #b9b6ad;
        background: transparent;
        color: inherit;
      }

      .step-error {
        margin: 1rem 0 0;
        padding: 0.8rem 1rem;
        border-left: 4px solid currentColor;
        font-weight: 700;
      }

      .portrait-panel {
        margin: 3rem 0 5rem;
        padding: clamp(1.5rem, 4vw, 3rem);
        border: 1px solid #b9b6ad;
        border-radius: 0.8rem;
      }

      .portrait-text {
        max-width: 1000px;
        font-size: clamp(1.45rem, 3vw, 2.4rem);
        line-height: 1.28;
        letter-spacing: -0.02em;
      }

      .portrait-caveat { max-width: 800px; font-size: 0.9rem; }

      .pattern-section { margin: 0 0 5rem; }


      .pattern-card {
        border: 1px solid #b9b6ad;
        border-radius: 0.8rem;
        padding: 1.5rem;
      }

      .pattern-card-head { border-bottom: 1px solid #d2cfc6; padding-bottom: 1rem; }
      .pattern-card-head > div { display: flex; justify-content: space-between; gap: 1rem; align-items: center; }
      .pattern-card h3 { margin: 0.6rem 0 0; font-size: clamp(1.5rem, 2.8vw, 2.2rem); }

      .pattern-rank { font-weight: 850; letter-spacing: 0.08em; }
      .pattern-strength {
        border: 1px solid #b9b6ad;
        border-radius: 999px;
        padding: 0.35rem 0.6rem;
        font-size: 0.75rem;
        font-weight: 750;
      }

      .pattern-description { font-size: 1.02rem; line-height: 1.6; }

      .modifier-note,
      .context-note {
        margin-top: 1rem;
        padding: 0.85rem 1rem;
        border-left: 3px solid #17202a;
        font-size: 0.9rem;
      }

      .modifier-note p { margin: 0.2rem 0; }

      .why-details {
        margin-top: 1.2rem;
        border-top: 1px solid #d2cfc6;
        padding-top: 1rem;
      }

      .why-details summary { cursor: pointer; font-weight: 750; }

      .why-block { margin-top: 1rem; }
      .why-block h4 { margin-bottom: 0.4rem; }
      .why-block ul { margin-top: 0.4rem; padding-left: 1.2rem; }

      .condition-state {
        display: inline-block;
        margin-left: 0.4rem;
        border: 1px solid #b9b6ad;
        border-radius: 999px;
        padding: 0.1rem 0.4rem;
        font-size: 0.72rem;
      }

      .role-rationale { font-size: 0.86rem; line-height: 1.5; }

      .pattern-feedback {
        margin-top: 1.2rem;
        padding-top: 1rem;
        border-top: 1px solid #d2cfc6;
      }

      .pattern-feedback > strong { display: block; margin-bottom: 0.75rem; }

      .fit-options label span,
      .dimension-fit-options label span {
        display: inline-block;
        padding: 0.55rem 0.75rem;
        border: 1px solid #b9b6ad;
        border-radius: 999px;
        cursor: pointer;
        font-size: 0.88rem;
      }

      .fit-options input:checked + span,
      .fit-options input:focus-visible + span,
      .dimension-fit-options input:checked + span,
      .dimension-fit-options input:focus-visible + span {
        background: #17202a;
        color: #f7f5ef;
        border-color: #17202a;
      }

      .overall-feedback {
        margin: 5rem 0;
        padding: 1.5rem;
        border: 1px solid #b9b6ad;
        border-radius: 0.75rem;
      }

      .overall-feedback h3 {
        max-width: 950px;
        font-size: clamp(1.4rem, 2.8vw, 2rem);
      }

      .missing-section {
        display: grid;
        grid-template-columns: 1fr 1.4fr;
        gap: 3rem;
        padding: 4rem 0;
        border-top: 1px solid #b9b6ad;
      }

      .missing-grid { display: grid; gap: 0.7rem; }

      .missing-choice span {
        display: block;
        padding: 1rem;
        border: 1px solid #b9b6ad;
        border-radius: 0.65rem;
        cursor: pointer;
      }

      .missing-choice strong,
      .missing-choice small { display: block; }

      .missing-choice small { margin-top: 0.35rem; line-height: 1.45; }

      .missing-choice input:checked + span {
        background: #17202a;
        color: #f7f5ef;
        border-color: #17202a;
      }

      .raw-profile {
        margin: 3rem 0 5rem;
        border-top: 1px solid #b9b6ad;
        border-bottom: 1px solid #b9b6ad;
        padding: 1.2rem 0;
      }

      .raw-profile summary { cursor: pointer; font-weight: 750; }

      .raw-score-grid {
        display: grid;
        grid-template-columns: repeat(4, 1fr);
        gap: 0.7rem;
        margin-top: 1rem;
      }

      .raw-score-item {
        border: 1px solid #d2cfc6;
        padding: 0.8rem;
        border-radius: 0.55rem;
        display: grid;
        gap: 0.15rem;
      }

      .raw-score-item strong { font-size: 0.8rem; }
      .raw-score-item small { line-height: 1.3; }

      .no-patterns { padding: 2rem; border: 1px solid #b9b6ad; border-radius: 0.8rem; }


      .missing-gate { margin-top: 1.5rem; }

      .small-note {
        font-size: 0.84rem;
        line-height: 1.45;
      }

      .missing-followups {
        margin-top: 1.2rem;
        display: grid;
        gap: 0.8rem;
      }

      .followup-card {
        border: 1px solid #b9b6ad;
        border-radius: 0.7rem;
        padding: 1rem;
      }

      .donation-section {
        display: grid;
        grid-template-columns: 1fr 1.4fr;
        gap: 3rem;
        padding: 4rem 0;
        border-top: 1px solid #b9b6ad;
      }

      .donation-panel {
        border: 1px solid #b9b6ad;
        border-radius: 0.8rem;
        padding: 1.3rem;
      }

      .donation-panel details {
        margin-bottom: 1.2rem;
      }

      .donation-preview {
        max-height: 340px;
        overflow: auto;
        padding: 1rem;
        border: 1px solid #d2cfc6;
        border-radius: 0.5rem;
        font-size: 0.72rem;
        white-space: pre-wrap;
        word-break: break-word;
      }

      .consent-checks {
        display: grid;
        gap: 0.65rem;
        margin: 1.2rem 0;
      }

      .consent-checks label {
        display: grid;
        grid-template-columns: auto 1fr;
        gap: 0.65rem;
        align-items: start;
      }

      .donation-panel button + button {
        margin-left: 0.5rem;
      }

      @media (max-width: 900px) {
        .pattern-results,
        .missing-section,
        .donation-section,
        .explore-intro,
        .pilot-note {
          grid-template-columns: 1fr;
        }

        .raw-score-grid { grid-template-columns: repeat(2, 1fr); }

        .questionnaire-head,
        .results-head,
        .section-heading {
          align-items: start;
          flex-direction: column;
        }

        .step-actions {
          grid-template-columns: 1fr;
        }

        .bottom-progress { order: -1; max-width: none; }
      }

      @media (max-width: 560px) {
        .explore-hero { padding-top: 4rem; }

        legend,
        .question-card { grid-template-columns: 1fr; gap: 0.8rem; }

        .score-options { grid-template-columns: repeat(5, 1fr); }
        .raw-score-grid { grid-template-columns: 1fr; }
      }


      .pattern-results {
        display: block;
      }

      .pattern-domain {
        padding: 2.5rem 0;
        border-top: 1px solid #b9b6ad;
      }

      .pattern-domain:first-child {
        border-top: 0;
        padding-top: 0;
      }

      .pattern-domain-heading {
        display: flex;
        justify-content: space-between;
        gap: 2rem;
        align-items: baseline;
        margin-bottom: 1.2rem;
      }

      .pattern-domain-heading span {
        font-size: 0.82rem;
      }

      .pattern-domain-grid {
        display: grid;
        grid-template-columns: repeat(2, 1fr);
        gap: 1rem;
      }

      .missing-domain {
        display: grid;
        gap: 0.7rem;
        padding-bottom: 1.5rem;
      }

      .missing-domain + .missing-domain {
        border-top: 1px solid #d2cfc6;
        padding-top: 1.5rem;
      }

      @media (max-width: 900px) {
        .pattern-domain-grid {
          grid-template-columns: 1fr;
        }
      }

      .print-report {
        display: none;
      }

      @media print {
        @page {
          size: A4;
          margin: 16mm 15mm 18mm;
        }

        html,
        body {
          background: #fff !important;
          color: #111 !important;
          font-size: 10pt;
        }

        body > header,
        body > footer,
        main > section:not(#results),
        #results > *:not(#print-report) {
          display: none !important;
        }

        #results {
          display: block !important;
          padding: 0 !important;
          margin: 0 !important;
        }

        #print-report {
          display: block !important;
          width: 100%;
          margin: 0;
          padding: 0;
          color: #111;
          background: #fff;
        }

        .print-report-header {
          padding-bottom: 10mm;
          border-bottom: 1px solid #777;
          margin-bottom: 7mm;
        }

        .print-report-mark {
          margin: 0 0 2mm;
          font-size: 9pt;
          font-weight: 800;
          letter-spacing: 0.12em;
        }

        .print-report h1 {
          margin: 0 0 2mm;
          font-size: 24pt;
          line-height: 1.05;
        }

        .print-report h2 {
          margin: 8mm 0 3mm;
          font-size: 14pt;
          border-bottom: 1px solid #bbb;
          padding-bottom: 2mm;
        }

        .print-report h3 {
          margin: 5mm 0 2mm;
          font-size: 10.5pt;
        }

        .print-report p,
        .print-report li {
          line-height: 1.45;
        }

        .print-report-meta,
        .print-note {
          font-size: 8.5pt;
        }

        .print-portrait {
          font-size: 12pt;
          line-height: 1.5 !important;
        }

        .print-pattern {
          break-inside: avoid;
          padding: 3mm 0 4mm;
          border-bottom: 1px solid #ddd;
        }

        .print-pattern-heading {
          display: flex;
          justify-content: space-between;
          gap: 6mm;
        }

        .print-pattern-heading span {
          font-size: 8.5pt;
        }

        .print-overall {
          margin-top: 5mm;
          padding-top: 3mm;
          border-top: 1px solid #777;
        }

        .print-score-group {
          break-inside: avoid;
          margin-bottom: 5mm;
        }

        .print-report table {
          width: 100%;
          border-collapse: collapse;
          font-size: 8.5pt;
        }

        .print-report th,
        .print-report td {
          text-align: left;
          padding: 1.6mm 1.5mm;
          border-bottom: 1px solid #ddd;
          vertical-align: top;
        }

        .print-report th:nth-child(1),
        .print-report td:nth-child(1) {
          width: 14%;
        }

        .print-report th:nth-child(3),
        .print-report td:nth-child(3),
        .print-report th:nth-child(4),
        .print-report td:nth-child(4) {
          width: 12%;
        }

        .print-disclaimer {
          margin-top: 10mm;
          border-top: 1px solid #777;
        }
      }
    </style>
  </body>
</html>
