---
import '../../styles/global.css';
import model from '../../../model/dynamos-v2.json';
import dimensions from '../../../model/dimensions.json';

const rawBase = import.meta.env.BASE_URL;
const base = rawBase.endsWith('/') ? rawBase : `${rawBase}/`;

const allDimensions = dimensions.categories.flatMap((category) =>
  category.dimensions.map((dimension) => ({
    ...dimension,
    categoryId: category.id,
    categoryName: category.name,
  }))
);

const questionnaireVersion = '1.0.0';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta
      name="description"
      content="Explore your DYNAMOS architecture with the 26-dimension reflective questionnaire. Phase 1 runs entirely in your browser."
    />
    <title>Explore Your Architecture — DYNAMOS</title>
  </head>

  <body>
    <header class="site-header">
      <a class="wordmark" href={base}>DYNAMOS</a>
      <nav aria-label="Primary navigation">
        <a href={`${base}model/`}>Model</a>
        <a href={`${base}precepta/`}>PRECEPTA</a>
        <a aria-current="page" href={`${base}explore/`}>Explore</a>
        <a href={`${base}responsible-use/`}>Responsible use</a>
      </nav>
    </header>

    <main>
      <section class="explore-hero">
        <p class="eyebrow">Private browser-based reflection · Phase 1</p>
        <h1>Explore your architecture.</h1>
        <p class="lede">
          Answer 26 questions about your typical functioning over time. Your answers
          are turned into a DYNAMOS dimension profile on this device.
        </p>

        <div class="privacy-banner">
          <strong>Nothing is transmitted.</strong>
          <span>
            In this first version, your answers and feedback stay in your browser.
            The anonymous research-contribution system will be added separately.
          </span>
        </div>
      </section>

      <section class="explore-intro">
        <div>
          <p class="eyebrow">Before you begin</p>
          <h2>This is reflection, not assessment.</h2>
        </div>
        <div>
          <p>
            Rate your <strong>typical functioning over time</strong>, rather than
            your best day or worst day. There are no good or bad scores.
          </p>
          <p>
            If one number cannot capture an important context difference, choose the
            closest score for now. Context-sensitive interpretation is part of DYNAMOS,
            but this first questionnaire intentionally keeps the input simple.
          </p>
          <p>
            You can download your profile when you finish and tell the model where
            its descriptions do or do not fit you.
          </p>
        </div>
      </section>

      <section id="questionnaire" class="questionnaire-section">
        <div class="questionnaire-head">
          <div>
            <p class="eyebrow">26 dimensions · 8 categories</p>
            <h2 id="step-title">Questionnaire</h2>
          </div>
          <div class="progress-box" aria-live="polite">
            <span id="progress-label">Category 1 of {dimensions.categories.length}</span>
            <progress id="category-progress" value="1" max={dimensions.categories.length}></progress>
          </div>
        </div>

        <div class="scale-reference" aria-label="Scale reference">
          {Object.entries(model.scoring.scale.anchors).map(([range, label]) => (
            <div>
              <strong>{range}</strong>
              <span>{label}</span>
            </div>
          ))}
        </div>

        <form id="dynamos-form" novalidate>
          {dimensions.categories.map((category, categoryIndex) => (
            <fieldset
              class="category-step"
              data-step={categoryIndex}
              hidden={categoryIndex !== 0}
            >
              <legend>
                <span class="category-step-number">{String(categoryIndex + 1).padStart(2, '0')}</span>
                <span>
                  <strong>{category.name}</strong>
                  <small>{category.description}</small>
                </span>
              </legend>

              <div class="question-stack">
                {category.dimensions.map((dimension, dimensionIndex) => (
                  <article class="question-card" data-dimension={dimension.id}>
                    <div class="question-number">
                      {String(dimensionIndex + 1).padStart(2, '0')}
                    </div>

                    <div class="question-main">
                      <p class="dimension-kicker">{dimension.id} · {dimension.name}</p>
                      <h3>{dimension.short}</h3>
                      <p>{dimension.description}</p>

                      <div
                        class="score-options"
                        role="radiogroup"
                        aria-label={`${dimension.id} ${dimension.name}`}
                      >
                        {Array.from({ length: 10 }, (_, i) => i + 1).map((score) => (
                          <label class="score-choice">
                            <input
                              type="radio"
                              name={dimension.id}
                              value={score}
                              required
                            />
                            <span>{score}</span>
                          </label>
                        ))}
                      </div>

                      <div class="score-ends" aria-hidden="true">
                        <span>Very low</span>
                        <span>Very high</span>
                      </div>
                    </div>
                  </article>
                ))}
              </div>

              <p class="step-error" data-error hidden>
                Please answer every dimension in this category before continuing.
              </p>

              <div class="step-actions">
                <button
                  class="secondary-button"
                  type="button"
                  data-prev
                  hidden={categoryIndex === 0}
                >
                  ← Previous
                </button>

                {categoryIndex < dimensions.categories.length - 1 ? (
                  <button class="primary-button" type="button" data-next>
                    Next category →
                  </button>
                ) : (
                  <button class="primary-button" type="submit">
                    Generate my profile →
                  </button>
                )}
              </div>
            </fieldset>
          ))}
        </form>
      </section>

      <section id="results" class="results-section" hidden>
        <div class="results-head">
          <div>
            <p class="eyebrow">Your local DYNAMOS profile</p>
            <h2>Your 26-dimension architecture</h2>
            <p>
              This is a descriptive fingerprint of the scores you entered. It is not a
              diagnosis, ranking, or performance score.
            </p>
          </div>

          <div class="results-actions">
            <button id="change-answers" class="secondary-button" type="button">
              ← Change answers
            </button>
            <button id="download-json" class="secondary-button" type="button">
              Download JSON
            </button>
            <button id="print-results" class="primary-button" type="button">
              Print / save as PDF
            </button>
          </div>
        </div>

        <div class="overall-feedback">
          <p class="eyebrow">Recognition feedback</p>
          <h3>Overall, how accurately does this dimension profile reflect how you see yourself?</h3>
          <p>
            This feedback is optional and currently stays on your device. Later, with
            explicit consent, it can become part of the anonymous model-development dataset.
          </p>

          <div class="fit-options" id="overall-fit" role="radiogroup" aria-label="Overall descriptive fit">
            {[
              ['very_accurate', 'Very accurate'],
              ['mostly_accurate', 'Mostly accurate'],
              ['partly_accurate', 'Partly accurate'],
              ['mostly_inaccurate', 'Mostly inaccurate'],
              ['very_inaccurate', 'Very inaccurate'],
            ].map(([value, label]) => (
              <label>
                <input type="radio" name="overall_fit" value={value} />
                <span>{label}</span>
              </label>
            ))}
          </div>
        </div>

        <div class="result-categories">
          {dimensions.categories.map((category) => (
            <section class="result-category">
              <div class="result-category-heading">
                <p class="eyebrow">{category.name}</p>
                <p>{category.description}</p>
              </div>

              <div class="result-grid">
                {category.dimensions.map((dimension) => (
                  <article class="result-card" data-result={dimension.id}>
                    <div class="result-topline">
                      <div>
                        <span class="result-code">{dimension.id}</span>
                        <h3>{dimension.name}</h3>
                      </div>
                      <strong class="result-score" data-score>—</strong>
                    </div>

                    <p class="result-short">{dimension.short}</p>

                    <div class="result-meter" aria-hidden="true">
                      <span data-meter></span>
                    </div>

                    <p class="result-anchor" data-anchor></p>
                    <p class="result-description">{dimension.description}</p>

                    <div class="dimension-fit">
                      <span>Does this description fit your experience?</span>
                      <div class="dimension-fit-options" data-fit-for={dimension.id}>
                        {[
                          ['fits', 'Yes'],
                          ['partly', 'Partly'],
                          ['does_not_fit', 'No'],
                          ['unsure', 'Unsure'],
                        ].map(([value, label]) => (
                          <label>
                            <input
                              type="radio"
                              name={`fit_${dimension.id}`}
                              value={value}
                            />
                            <span>{label}</span>
                          </label>
                        ))}
                      </div>
                    </div>
                  </article>
                ))}
              </div>
            </section>
          ))}
        </div>

        <section class="research-preview">
          <div>
            <p class="eyebrow">Next phase</p>
            <h2>Anonymous contribution, by explicit opt-in.</h2>
          </div>
          <div>
            <p>
              The next version will let you choose whether to contribute a minimal
              research record containing your 26 scores, model version, and recognition
              feedback. No contribution will happen automatically.
            </p>
            <p>
              Until that backend is connected, this page does not send questionnaire
              data anywhere.
            </p>
          </div>
        </section>
      </section>
    </main>

    <footer>
      <div>
        <p>
          <strong>DYNAMOS — Dynamic Neuro-Operational Systems Model</strong><br />
          © {model.copyright.year} {model.copyright.holder}
        </p>
        <p>Model and content licensed under CC BY-SA 4.0.</p>
      </div>

      <div class="footer-notice">
        <p>
          <strong>Responsible use:</strong> DYNAMOS is non-diagnostic and is not a
          performance evaluation.
        </p>
        <p><a href={`${base}responsible-use/`}>Responsible-use statement →</a></p>
      </div>
    </footer>

    <script
      type="application/json"
      id="dynamos-questionnaire-meta"
      set:html={JSON.stringify({
        model: model.name,
        modelVersion: model.version,
        questionnaireVersion,
        dimensionIds: allDimensions.map((d) => d.id),
        scaleAnchors: model.scoring.scale.anchors,
      })}
    ></script>

    <script>
      const form = document.querySelector('#dynamos-form');
      const steps = Array.from(document.querySelectorAll('.category-step'));
      const progress = document.querySelector('#category-progress');
      const progressLabel = document.querySelector('#progress-label');
      const questionnaire = document.querySelector('#questionnaire');
      const results = document.querySelector('#results');
      const metadata = JSON.parse(
        document.querySelector('#dynamos-questionnaire-meta').textContent
      );

      let activeStep = 0;

      function showStep(index) {
        activeStep = Math.max(0, Math.min(index, steps.length - 1));

        steps.forEach((step, i) => {
          step.hidden = i !== activeStep;
        });

        progress.value = activeStep + 1;
        progressLabel.textContent = `Category ${activeStep + 1} of ${steps.length}`;
        steps[activeStep].querySelector('[data-error]').hidden = true;
        steps[activeStep].scrollIntoView({ behavior: 'smooth', block: 'start' });
      }

      function unansweredInputs(step) {
        const names = [...new Set(
          Array.from(step.querySelectorAll('input[type="radio"][required]'))
            .map((input) => input.name)
        )];

        return names.filter(
          (name) => !step.querySelector(`input[name="${CSS.escape(name)}"]:checked`)
        );
      }

      steps.forEach((step, index) => {
        const next = step.querySelector('[data-next]');
        const prev = step.querySelector('[data-prev]');

        next?.addEventListener('click', () => {
          const missing = unansweredInputs(step);
          if (missing.length) {
            step.querySelector('[data-error]').hidden = false;
            step.querySelector(`input[name="${CSS.escape(missing[0])}"]`)?.focus();
            return;
          }

          showStep(index + 1);
        });

        prev?.addEventListener('click', () => showStep(index - 1));
      });

      function getScores() {
        const scores = {};
        for (const id of metadata.dimensionIds) {
          const checked = form.querySelector(`input[name="${CSS.escape(id)}"]:checked`);
          if (checked) scores[id] = Number(checked.value);
        }
        return scores;
      }

      function anchorFor(score) {
        if (score <= 2) return metadata.scaleAnchors['1-2'];
        if (score <= 4) return metadata.scaleAnchors['3-4'];
        if (score <= 6) return metadata.scaleAnchors['5-6'];
        if (score <= 8) return metadata.scaleAnchors['7-8'];
        return metadata.scaleAnchors['9-10'];
      }

      function renderResults(scores) {
        for (const [id, score] of Object.entries(scores)) {
          const card = document.querySelector(`[data-result="${CSS.escape(id)}"]`);
          if (!card) continue;

          card.querySelector('[data-score]').textContent = `${score}/10`;
          card.querySelector('[data-anchor]').textContent = anchorFor(score);
          card.querySelector('[data-meter]').style.width = `${score * 10}%`;
        }
      }

      form.addEventListener('submit', (event) => {
        event.preventDefault();

        const finalStep = steps[steps.length - 1];
        const missing = unansweredInputs(finalStep);

        if (missing.length) {
          finalStep.querySelector('[data-error]').hidden = false;
          finalStep.querySelector(`input[name="${CSS.escape(missing[0])}"]`)?.focus();
          return;
        }

        const scores = getScores();

        if (Object.keys(scores).length !== metadata.dimensionIds.length) {
          const firstIncomplete = steps.findIndex((step) => unansweredInputs(step).length);
          if (firstIncomplete >= 0) showStep(firstIncomplete);
          return;
        }

        renderResults(scores);
        questionnaire.hidden = true;
        results.hidden = false;
        window.location.hash = 'results';
        results.scrollIntoView({ behavior: 'smooth', block: 'start' });
      });

      document.querySelector('#change-answers').addEventListener('click', () => {
        results.hidden = true;
        questionnaire.hidden = false;
        window.location.hash = 'questionnaire';
        questionnaire.scrollIntoView({ behavior: 'smooth', block: 'start' });
      });

      function selectedValue(name) {
        return document.querySelector(`input[name="${CSS.escape(name)}"]:checked`)?.value ?? null;
      }

      function buildDownloadPayload() {
        const dimensionFeedback = {};

        for (const id of metadata.dimensionIds) {
          dimensionFeedback[id] = selectedValue(`fit_${id}`);
        }

        return {
          schema: 'dynamos-local-profile',
          schema_version: '1.0.0',
          generated_at: new Date().toISOString(),
          model: metadata.model,
          model_version: metadata.modelVersion,
          questionnaire_version: metadata.questionnaireVersion,
          privacy_mode: 'local_only_no_transmission',
          scores: getScores(),
          recognition_feedback: {
            overall_fit: selectedValue('overall_fit'),
            dimensions: dimensionFeedback,
          },
          note:
            'This file was generated locally in the browser. It is a reflective DYNAMOS profile, not a diagnosis or performance evaluation.',
        };
      }

      document.querySelector('#download-json').addEventListener('click', () => {
        const payload = buildDownloadPayload();
        const blob = new Blob([JSON.stringify(payload, null, 2)], {
          type: 'application/json',
        });

        const url = URL.createObjectURL(blob);
        const a = document.createElement('a');
        a.href = url;
        a.download = `dynamos-profile-${metadata.modelVersion}.json`;
        document.body.appendChild(a);
        a.click();
        a.remove();
        URL.revokeObjectURL(url);
      });

      document.querySelector('#print-results').addEventListener('click', () => {
        window.print();
      });
    </script>

    <style>
      .explore-hero {
        padding: 7rem 2rem 5rem;
      }

      .privacy-banner {
        max-width: 850px;
        margin-top: 3rem;
        padding: 1.25rem 1.5rem;
        border-left: 4px solid currentColor;
        display: grid;
        gap: 0.35rem;
      }

      .explore-intro,
      .research-preview {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 4rem;
        padding: 5rem 2rem;
        border-top: 1px solid #b9b6ad;
        border-bottom: 1px solid #b9b6ad;
      }

      .questionnaire-section,
      .results-section {
        padding: 5rem 2rem 7rem;
      }

      .questionnaire-head,
      .results-head {
        display: flex;
        justify-content: space-between;
        gap: 3rem;
        align-items: end;
        margin-bottom: 2rem;
      }

      .progress-box {
        min-width: 230px;
        display: grid;
        gap: 0.6rem;
      }

      progress {
        width: 100%;
        height: 0.55rem;
        accent-color: #17202a;
      }

      .scale-reference {
        display: grid;
        grid-template-columns: repeat(5, 1fr);
        border-top: 1px solid #b9b6ad;
        border-bottom: 1px solid #b9b6ad;
        margin-bottom: 4rem;
      }

      .scale-reference div {
        padding: 1rem 1rem 1rem 0;
        display: grid;
        gap: 0.2rem;
      }

      .scale-reference strong {
        font-size: 1.1rem;
      }

      .scale-reference span {
        font-size: 0.82rem;
      }

      fieldset {
        padding: 0;
        margin: 0;
        border: 0;
      }

      legend {
        width: 100%;
        display: grid;
        grid-template-columns: 70px 1fr;
        gap: 1.5rem;
        align-items: start;
        padding: 0 0 2.5rem;
      }

      legend strong {
        display: block;
        font-size: clamp(1.8rem, 4vw, 3.4rem);
        line-height: 1;
        letter-spacing: -0.035em;
      }

      legend small {
        display: block;
        max-width: 760px;
        margin-top: 0.75rem;
        font-size: 1rem;
        font-weight: 400;
      }

      .category-step-number,
      .question-number {
        font-weight: 800;
        letter-spacing: 0.08em;
      }

      .question-stack {
        border-top: 1px solid #b9b6ad;
      }

      .question-card {
        display: grid;
        grid-template-columns: 70px 1fr;
        gap: 1.5rem;
        padding: 2.3rem 0;
        border-bottom: 1px solid #d2cfc6;
      }

      .dimension-kicker {
        margin: 0 0 0.35rem;
        font-size: 0.82rem;
        text-transform: uppercase;
        letter-spacing: 0.08em;
        font-weight: 750;
      }

      .question-card h3 {
        margin: 0;
        font-size: clamp(1.35rem, 2.7vw, 2rem);
      }

      .question-card p {
        max-width: 850px;
      }

      .score-options {
        display: grid;
        grid-template-columns: repeat(10, minmax(0, 1fr));
        gap: 0.45rem;
        margin-top: 1.5rem;
      }

      .score-choice input,
      .fit-options input,
      .dimension-fit-options input {
        position: absolute;
        opacity: 0;
        pointer-events: none;
      }

      .score-choice span {
        display: grid;
        place-items: center;
        min-height: 48px;
        border: 1px solid #b9b6ad;
        border-radius: 0.55rem;
        cursor: pointer;
        font-weight: 750;
        transition: 120ms ease;
      }

      .score-choice input:checked + span,
      .score-choice input:focus-visible + span {
        background: #17202a;
        color: #f7f5ef;
        border-color: #17202a;
      }

      .score-choice span:hover {
        border-color: #17202a;
      }

      .score-ends {
        display: flex;
        justify-content: space-between;
        margin-top: 0.45rem;
        font-size: 0.78rem;
      }

      .step-actions,
      .results-actions {
        display: flex;
        gap: 0.8rem;
        flex-wrap: wrap;
      }

      .step-actions {
        justify-content: flex-end;
        margin-top: 2.5rem;
      }

      button {
        font: inherit;
      }

      .primary-button,
      .secondary-button {
        min-height: 44px;
        padding: 0.72rem 1rem;
        border-radius: 0.55rem;
        cursor: pointer;
        font-weight: 750;
      }

      .primary-button {
        border: 1px solid #17202a;
        background: #17202a;
        color: #f7f5ef;
      }

      .secondary-button {
        border: 1px solid #b9b6ad;
        background: transparent;
        color: inherit;
      }

      .primary-button:hover,
      .secondary-button:hover {
        transform: translateY(-1px);
      }

      .step-error {
        margin: 1rem 0 0;
        padding: 0.8rem 1rem;
        border-left: 4px solid currentColor;
        font-weight: 700;
      }

      .overall-feedback {
        margin: 3rem 0 5rem;
        padding: 1.5rem;
        border: 1px solid #b9b6ad;
        border-radius: 0.75rem;
      }

      .overall-feedback h3 {
        max-width: 850px;
        font-size: clamp(1.4rem, 2.8vw, 2rem);
      }

      .fit-options,
      .dimension-fit-options {
        display: flex;
        gap: 0.55rem;
        flex-wrap: wrap;
      }

      .fit-options label span,
      .dimension-fit-options label span {
        display: inline-block;
        padding: 0.55rem 0.75rem;
        border: 1px solid #b9b6ad;
        border-radius: 999px;
        cursor: pointer;
        font-size: 0.88rem;
      }

      .fit-options input:checked + span,
      .fit-options input:focus-visible + span,
      .dimension-fit-options input:checked + span,
      .dimension-fit-options input:focus-visible + span {
        background: #17202a;
        color: #f7f5ef;
        border-color: #17202a;
      }

      .result-category {
        padding: 4rem 0;
        border-top: 1px solid #b9b6ad;
      }

      .result-category-heading {
        max-width: 760px;
        margin-bottom: 2rem;
      }

      .result-grid {
        display: grid;
        grid-template-columns: repeat(2, 1fr);
        gap: 1rem;
      }

      .result-card {
        padding: 1.4rem;
        border: 1px solid #b9b6ad;
        border-radius: 0.75rem;
      }

      .result-topline {
        display: flex;
        justify-content: space-between;
        gap: 1rem;
      }

      .result-topline h3 {
        margin: 0.2rem 0 0;
      }

      .result-code {
        font-size: 0.78rem;
        font-weight: 800;
        letter-spacing: 0.08em;
      }

      .result-score {
        font-size: 1.45rem;
      }

      .result-short {
        font-weight: 700;
      }

      .result-meter {
        height: 0.6rem;
        margin: 1rem 0 0.5rem;
        background: #dedbd2;
        overflow: hidden;
        border-radius: 999px;
      }

      .result-meter span {
        display: block;
        height: 100%;
        width: 0;
        background: #17202a;
      }

      .result-anchor {
        margin-top: 0.2rem;
        font-size: 0.82rem;
        font-weight: 750;
      }

      .result-description {
        font-size: 0.95rem;
      }

      .dimension-fit {
        margin-top: 1.3rem;
        padding-top: 1.1rem;
        border-top: 1px solid #d2cfc6;
      }

      .dimension-fit > span {
        display: block;
        margin-bottom: 0.75rem;
        font-size: 0.86rem;
        font-weight: 700;
      }

      .research-preview {
        margin-top: 5rem;
      }

      @media (max-width: 820px) {
        .explore-intro,
        .research-preview,
        .result-grid {
          grid-template-columns: 1fr;
        }

        .questionnaire-head,
        .results-head {
          align-items: start;
          flex-direction: column;
        }

        .scale-reference {
          grid-template-columns: 1fr;
        }

        .scale-reference div + div {
          border-top: 1px solid #d2cfc6;
        }

        .score-options {
          grid-template-columns: repeat(5, 1fr);
        }
      }

      @media (max-width: 560px) {
        .explore-hero {
          padding-top: 4rem;
        }

        legend,
        .question-card {
          grid-template-columns: 1fr;
          gap: 0.8rem;
        }

        .score-options {
          grid-template-columns: repeat(5, 1fr);
        }

        .step-actions {
          justify-content: stretch;
        }

        .step-actions button {
          flex: 1;
        }
      }

      @media print {
