---
import '../../styles/global.css';
import model from '../../../model/dynamos-v2.json';
import dimensions from '../../../model/dimensions.json';
import precepta from '../../../model/precepta.json';
import cognitiveDerivation from '../../../model/precepta-derivation-cognitive.json';
import cognitiveFollowups from '../../../model/research/cognitive-missing-followups.json';

const rawBase = import.meta.env.BASE_URL;
const base = rawBase.endsWith('/') ? rawBase : `${rawBase}/`;

const allDimensions = dimensions.categories.flatMap((category) =>
  category.dimensions.map((dimension) => ({
    ...dimension,
    categoryId: category.id,
    categoryName: category.name,
  }))
);

const cognitivePatterns = precepta.domains.find((domain) => domain.id === 'cognitive_learning')?.patterns ?? [];
const questionnaireVersion = '1.1.0-pilot';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content="Explore your DYNAMOS architecture. This pilot derives the Cognitive & Learning PRECEPTA layer locally in your browser." />
    <title>Explore Your Architecture — DYNAMOS</title>
  </head>

  <body>
    <header class="site-header">
      <a class="wordmark" href={base}>DYNAMOS</a>
      <nav aria-label="Primary navigation">
        <a href={`${base}model/`}>Model</a>
        <a href={`${base}precepta/`}>PRECEPTA</a>
        <a aria-current="page" href={`${base}explore/`}>Explore</a>
        <a href={`${base}responsible-use/`}>Responsible use</a>
      </nav>
    </header>

    <main>
      <section class="explore-hero">
        <p class="eyebrow">Private browser-based reflection · Cognitive PRECEPTA pilot</p>
        <h1>Explore your architecture.</h1>
        <p class="lede">
          Answer 26 questions. DYNAMOS then uses the combination of your answers to
          generate higher-order PRECEPTA hypotheses rather than simply repeating your scores back to you.
        </p>

        <div class="privacy-banner">
          <strong>Nothing is transmitted.</strong>
          <span>
            This pilot runs entirely in your browser. Your scores and recognition feedback
            remain on this device unless you choose to download them.
          </span>
        </div>
      </section>

      <section class="explore-intro">
        <div>
          <p class="eyebrow">How to rate yourself</p>
          <h2>Use other adults as your mental reference point.</h2>
        </div>
        <div>
          <p>
            Score your <strong>typical functioning over time</strong>, not your best or worst day.
          </p>
          <p>
            The scale is a comparative self-estimate: ask yourself how strongly each statement
            characterizes you <strong>relative to what you perceive as typical among other adults</strong>.
            The result is not a population percentile; it is your own comparative estimate.
          </p>
          <p>
            There are no good or bad patterns. The research question comes later:
            does the higher-order interpretation generated from these answers actually describe you?
          </p>
        </div>
      </section>

      <section id="questionnaire" class="questionnaire-section">
        <div class="questionnaire-head">
          <div>
            <p class="eyebrow">26 dimensions · 8 categories</p>
            <h2>Questionnaire</h2>
          </div>
          <div class="progress-box" aria-live="polite">
            <span id="progress-label">0 of 26 answered</span>
            <progress id="answer-progress-top" value="0" max="26"></progress>
          </div>
        </div>

        <div class="scale-reference" aria-label="Scale reference">
          {Object.entries(model.scoring.scale.anchors).map(([range, label]) => (
            <div>
              <strong>{range}</strong>
              <span>{label}</span>
            </div>
          ))}
        </div>

        <form id="dynamos-form" novalidate>
          {dimensions.categories.map((category, categoryIndex) => (
            <fieldset class="category-step" data-step={categoryIndex} hidden={categoryIndex !== 0}>
              <legend>
                <span class="category-step-number">{String(categoryIndex + 1).padStart(2, '0')}</span>
                <span>
                  <strong>{category.name}</strong>
                  <small>{category.description}</small>
                </span>
              </legend>

              <div class="question-stack">
                {category.dimensions.map((dimension, dimensionIndex) => (
                  <article class="question-card" data-dimension={dimension.id}>
                    <div class="question-number">{String(dimensionIndex + 1).padStart(2, '0')}</div>

                    <div class="question-main">
                      <p class="dimension-kicker">{dimension.id} · {dimension.name}</p>
                      <h3>{dimension.short}</h3>
                      <p>{dimension.description}</p>

                      <div class="score-options" role="radiogroup" aria-label={`${dimension.id} ${dimension.name}`}>
                        {Array.from({ length: 10 }, (_, i) => i + 1).map((score) => (
                          <label class="score-choice">
                            <input type="radio" name={dimension.id} value={score} required />
                            <span>{score}</span>
                          </label>
                        ))}
                      </div>

                      <div class="score-ends" aria-hidden="true">
                        <span>Very low compared with others</span>
                        <span>Very high compared with others</span>
                      </div>
                    </div>
                  </article>
                ))}
              </div>

              <p class="step-error" data-error hidden>
                Please answer every dimension in this category before continuing.
              </p>

              <div class="step-actions">
                <button class="secondary-button" type="button" data-prev hidden={categoryIndex === 0}>
                  ← Previous
                </button>

                <div class="bottom-progress" aria-live="polite">
                  <div class="bottom-progress-row">
                    <span data-bottom-progress-label>0 / 26</span>
                    <span data-bottom-progress-percent>0%</span>
                  </div>
                  <progress data-bottom-progress value="0" max="26"></progress>
                </div>

                {categoryIndex < dimensions.categories.length - 1 ? (
                  <button class="primary-button" type="button" data-next>
                    Next category →
                  </button>
                ) : (
                  <button class="primary-button" type="submit">
                    Interpret my profile →
                  </button>
                )}
              </div>
            </fieldset>
          ))}
        </form>
      </section>

      <section id="results" class="results-section" hidden>
        <div class="results-head">
          <div>
            <p class="eyebrow">PRECEPTA pilot · Cognitive & Learning only</p>
            <h2>Your first higher-order interpretation</h2>
            <p>
              This pilot currently tests only 8 Cognitive & Learning PRECEPTA patterns.
              The remaining PRECEPTA domains will be added after this derivation method is tested.
            </p>
          </div>

          <div class="results-actions">
            <button id="change-answers" class="secondary-button" type="button">← Change answers</button>
            <button id="download-json" class="secondary-button" type="button">Download result</button>
            <button id="print-results" class="primary-button" type="button">Print / save as PDF</button>
          </div>
        </div>

        <section class="portrait-panel">
          <p class="eyebrow">Integrated cognitive portrait</p>
          <p id="portrait-text" class="portrait-text"></p>
          <p class="portrait-caveat">
            This is a model hypothesis generated from combinations of your self-ratings.
            It is not a diagnosis, category, probability, or performance judgment.
          </p>
        </section>

        <section class="pattern-section">
          <div class="section-heading">
            <div>
              <p class="eyebrow">What DYNAMOS inferred</p>
              <h2>Candidate PRECEPTA patterns</h2>
            </div>
            <p>
              “Strong” means all current core conditions were directly satisfied.
              “Candidate” means the core pattern was compatible but at least one condition sat in the adjacent score band.
            </p>
          </div>

          <div id="pattern-results" class="pattern-results"></div>
        </section>

        <section class="overall-feedback">
          <p class="eyebrow">The actual research question</p>
          <h3>Overall, how well does this higher-order Cognitive & Learning interpretation describe your experience?</h3>
          <div class="fit-options" role="radiogroup" aria-label="Overall PRECEPTA fit">
            {[
              ['strongly_recognize', 'Strongly recognize it'],
              ['mostly_recognize', 'Mostly recognize it'],
              ['partly_recognize', 'Partly recognize it'],
              ['do_not_recognize', 'Do not recognize it'],
              ['do_not_understand', 'I do not understand it'],
            ].map(([value, label]) => (
              <label>
                <input type="radio" name="overall_precepta_fit" value={value} />
                <span>{label}</span>
              </label>
            ))}
          </div>
        </section>

        <section class="missing-section">
          <div>
            <p class="eyebrow">False negatives matter too</p>
            <h2>Is an important part of how you think or work missing from this interpretation?</h2>
            <p>
              Answer this before seeing the patterns the model did not infer. That order is deliberate:
              it reduces the chance that merely reading another description makes it feel missing.
            </p>

            <div class="missing-gate fit-options" id="missing-gate">
              <label><input type="radio" name="important_part_missing" value="yes" /><span>Yes</span></label>
              <label><input type="radio" name="important_part_missing" value="no" /><span>No</span></label>
              <label><input type="radio" name="important_part_missing" value="unsure" /><span>Unsure</span></label>
            </div>
          </div>

          <div id="missing-pattern-panel" hidden>
            <p><strong>Which important pattern appears to be missing?</strong></p>
            <p class="small-note">Choose at most three. Only patterns not shown in your result will be available.</p>
            <div id="missing-pattern-list" class="missing-grid"></div>
            <div id="missing-followups" class="missing-followups"></div>
          </div>
        </section>

        <section class="donation-section">
          <div>
            <p class="eyebrow">Voluntary research contribution</p>
            <h2>Donate this result to DYNAMOS research?</h2>
            <p>
              Your questionnaire and PRECEPTA interpretation are still local. Nothing has been sent.
              The donation contract deliberately excludes names, contact details, employer,
              diagnosis, exact location, and free text.
            </p>
          </div>

          <div class="donation-panel">
            <details>
              <summary>See exactly what a donated record contains</summary>
              <pre id="donation-preview" class="donation-preview"></pre>
            </details>

            <div class="consent-checks">
              <label><input type="checkbox" name="consent_voluntary" /> <span>I am contributing voluntarily.</span></label>
              <label><input type="checkbox" name="consent_exploratory" /> <span>I understand DYNAMOS is exploratory and non-diagnostic.</span></label>
              <label><input type="checkbox" name="consent_no_identity" /> <span>I understand that no identity is requested as part of this research record.</span></label>
              <label><input type="checkbox" name="consent_aggregate" /> <span>I understand that aggregate statistics may be published.</span></label>
              <label><input type="checkbox" name="consent_withdrawal" /> <span>I understand that I will need my withdrawal token if I later want this contribution deleted.</span></label>
            </div>

            <button id="prepare-donation" class="primary-button" type="button">
              Prepare donation preview
            </button>

            <button id="donate-result" class="secondary-button" type="button" disabled>
              Donation endpoint not connected yet
            </button>

            <p id="donation-status" class="small-note">
              This pilot only prepares and validates the research payload locally. It does not send data.
            </p>
          </div>
        </section>

        <details class="raw-profile">
          <summary>See the 26 self-ratings used underneath this interpretation</summary>
          <div id="raw-score-grid" class="raw-score-grid"></div>
        </details>

        <section class="pilot-note">
          <div>
            <p class="eyebrow">Important pilot limitation</p>
            <h2>One Cognitive pattern is deliberately not inferred yet.</h2>
          </div>
          <div>
            <p>
              <strong>Fast Insight / Slow Explanation</strong> is currently excluded from automatic inference.
              The existing 26 questions do not directly measure the defining gap between arriving at an insight
              and being able to explain its intermediate steps. We would rather expose that gap than fake a precise inference.
            </p>
          </div>
        </section>
      </section>
    </main>

    <footer>
      <div>
        <p><strong>DYNAMOS — Dynamic Neuro-Operational Systems Model</strong><br />© {model.copyright.year} {model.copyright.holder}</p>
        <p>Model and content licensed under CC BY-SA 4.0.</p>
      </div>
      <div class="footer-notice">
        <p><strong>Responsible use:</strong> DYNAMOS is non-diagnostic and is not a performance evaluation.</p>
        <p><a href={`${base}responsible-use/`}>Responsible-use statement →</a></p>
      </div>
    </footer>

    <script
      type="application/json"
      id="dynamos-questionnaire-meta"
      set:html={JSON.stringify({
        model: model.name,
        modelVersion: model.version,
        questionnaireVersion,
        dimensionIds: allDimensions.map((d) => d.id),
        dimensions: allDimensions.map((d) => ({ id: d.id, name: d.name })),
        derivation: cognitiveDerivation,
        followups: cognitiveFollowups,
      })}
    ></script>

    <script>
      const form = document.querySelector('#dynamos-form');
      const steps = Array.from(document.querySelectorAll('.category-step'));
      const questionnaire = document.querySelector('#questionnaire');
      const results = document.querySelector('#results');
      const metadata = JSON.parse(document.querySelector('#dynamos-questionnaire-meta').textContent);

      let activeStep = 0;
      let latestDerivation = [];

      function answeredCount() {
        return metadata.dimensionIds.filter((id) =>
          form.querySelector(`input[name="${CSS.escape(id)}"]:checked`)
        ).length;
      }

      function updateProgress() {
        const answered = answeredCount();
        const pct = Math.round((answered / metadata.dimensionIds.length) * 100);

        document.querySelector('#progress-label').textContent = `${answered} of ${metadata.dimensionIds.length} answered`;
        document.querySelector('#answer-progress-top').value = answered;

        document.querySelectorAll('[data-bottom-progress]').forEach((el) => el.value = answered);
        document.querySelectorAll('[data-bottom-progress-label]').forEach((el) => el.textContent = `${answered} / ${metadata.dimensionIds.length}`);
        document.querySelectorAll('[data-bottom-progress-percent]').forEach((el) => el.textContent = `${pct}%`);
      }

      function showStep(index) {
        activeStep = Math.max(0, Math.min(index, steps.length - 1));
        steps.forEach((step, i) => step.hidden = i !== activeStep);
        steps[activeStep].querySelector('[data-error]').hidden = true;
        steps[activeStep].scrollIntoView({ behavior: 'smooth', block: 'start' });
      }

      function unansweredInputs(step) {
        const names = [...new Set(
          Array.from(step.querySelectorAll('input[type="radio"][required]')).map((input) => input.name)
        )];
        return names.filter((name) => !step.querySelector(`input[name="${CSS.escape(name)}"]:checked`));
      }

      form.addEventListener('change', updateProgress);

      steps.forEach((step, index) => {
        const next = step.querySelector('[data-next]');
        const prev = step.querySelector('[data-prev]');

        next?.addEventListener('click', () => {
          const missing = unansweredInputs(step);
          if (missing.length) {
            step.querySelector('[data-error]').hidden = false;
            step.querySelector(`input[name="${CSS.escape(missing[0])}"]`)?.focus();
            return;
          }
          showStep(index + 1);
        });

        prev?.addEventListener('click', () => showStep(index - 1));
      });

      function getScores() {
        const scores = {};
        for (const id of metadata.dimensionIds) {
          const checked = form.querySelector(`input[name="${CSS.escape(id)}"]:checked`);
          if (checked) scores[id] = Number(checked.value);
        }
        return scores;
      }

      function band(score) {
        if (score <= 2) return 'very_low';
        if (score <= 4) return 'low';
        if (score <= 6) return 'moderate';
        if (score <= 8) return 'high';
        return 'very_high';
      }

      function arrow(score) {
        if (score <= 2) return '↓↓';
        if (score <= 4) return '↓';
        if (score <= 6) return '↔';
        if (score <= 8) return '↑';
        return '↑↑';
      }

      function conditionState(score, target) {
        const b = band(score);

        if (target === 'high') {
          if (b === 'high' || b === 'very_high') return 'hit';
          if (b === 'moderate') return 'near';
          return 'miss';
        }

        if (target === 'very_high') {
          if (b === 'very_high') return 'hit';
          if (b === 'high') return 'near';
          return 'miss';
        }

        if (target === 'low') {
          if (b === 'very_low' || b === 'low') return 'hit';
          if (b === 'moderate') return 'near';
          return 'miss';
        }

        if (target === 'moderate') {
          if (b === 'moderate') return 'hit';
          if (b === 'low' || b === 'high') return 'near';
          return 'miss';
        }

        return 'miss';
      }

      function inferPatterns(scores) {
        const candidates = [];

        for (const pattern of metadata.derivation.patterns) {
          if (pattern.inference_status === 'not_directly_inferable') continue;

          const coreStates = pattern.core.map((c) => ({
            ...c,
            state: conditionState(scores[c.dimension], c.target),
            score: scores[c.dimension],
          }));

          if (coreStates.some((c) => c.state === 'miss')) continue;

          const supportingStates = pattern.supporting.map((c) => ({
            ...c,
            state: conditionState(scores[c.dimension], c.target),
            score: scores[c.dimension],
          }));

          const strength = coreStates.every((c) => c.state === 'hit') ? 'strong' : 'candidate';
          const supportHits = supportingStates.filter((c) => c.state === 'hit').length;
          const supportNear = supportingStates.filter((c) => c.state === 'near').length;

          const activeModifiers = (pattern.modifiers ?? []).filter((m) =>
            conditionState(scores[m.dimension], m.if) === 'hit'
          );

          candidates.push({
            ...pattern,
            strength,
            coreStates,
            supportingStates,
            supportHits,
            supportNear,
            activeModifiers,
          });
        }

        candidates.sort((a, b) => {
          const strengthRank = { strong: 2, candidate: 1 };
          return (
            strengthRank[b.strength] - strengthRank[a.strength] ||
            b.supportHits - a.supportHits ||
            b.supportNear - a.supportNear ||
            a.name.localeCompare(b.name)
          );
        });

        return candidates.slice(0, 4);
      }

      function humanTarget(target) {
        return {
          high: 'high',
          very_high: 'very high',
          low: 'low',
          moderate: 'moderate',
        }[target] ?? target;
      }

      function renderPatternCard(pattern, index) {
        const core = pattern.coreStates.map((c) =>
          `<li><strong>${c.dimension} ${arrow(c.score)}</strong> — core target ${humanTarget(c.target)} <span class="condition-state ${c.state}">${c.state}</span></li>`
        ).join('');

        const supporting = pattern.supportingStates.length
          ? `<div class="why-block"><h4>Supporting signals</h4><ul>${pattern.supportingStates.map((c) =>
              `<li><strong>${c.dimension} ${arrow(c.score)}</strong> — target ${humanTarget(c.target)} <span class="condition-state ${c.state}">${c.state}</span></li>`
            ).join('')}</ul></div>`
          : '';

        const modifiers = pattern.activeModifiers.length
          ? `<div class="modifier-note">${pattern.activeModifiers.map((m) => `<p>${m.text}</p>`).join('')}</div>`
          : '';

        const context = pattern.context_note
          ? `<p class="context-note"><strong>Context caveat:</strong> ${pattern.context_note}</p>`
          : '';

        return `
          <article class="pattern-card">
            <div class="pattern-card-head">
              <div>
                <span class="pattern-rank">${String(index + 1).padStart(2, '0')}</span>
                <span class="pattern-strength">${pattern.strength === 'strong' ? 'Strong current match' : 'Current candidate'}</span>
              </div>
              <h3>${pattern.name}</h3>
            </div>

            <p class="pattern-description">${pattern.description}</p>
            ${modifiers}
            ${context}

            <details class="why-details">
              <summary>Why DYNAMOS inferred this</summary>
              <div class="why-block">
                <h4>Core conditions</h4>
                <ul>${core}</ul>
              </div>
              ${supporting}
              <p class="role-rationale">${pattern.role_rationale}</p>
            </details>

            <div class="pattern-feedback">
              <strong>Do you recognize this pattern in yourself?</strong>
              <div class="dimension-fit-options" data-pattern-fit="${pattern.id}">
                ${[
                  ['strongly_recognize', 'Strongly'],
                  ['mostly_recognize', 'Mostly'],
                  ['partly_recognize', 'Partly'],
                  ['do_not_recognize', 'No'],
                  ['do_not_understand', 'Unclear'],
                ].map(([value, label]) =>
                  `<label><input type="radio" name="fit_${pattern.id}" value="${value}" /><span>${label}</span></label>`
                ).join('')}
              </div>
            </div>
          </article>
        `;
      }

      function renderRawScores(scores) {
        const grid = document.querySelector('#raw-score-grid');
        grid.innerHTML = metadata.dimensions.map((d) =>
          `<div class="raw-score-item"><strong>${d.id}</strong><span>${scores[d.id]}/10 · ${arrow(scores[d.id])}</span><small>${d.name}</small></div>`
        ).join('');
      }

      function renderResults(scores) {
        latestDerivation = inferPatterns(scores);
        const container = document.querySelector('#pattern-results');

        if (!latestDerivation.length) {
          container.innerHTML = `
            <div class="no-patterns">
              <h3>No Cognitive & Learning PRECEPTA pattern passed the current core gate.</h3>
              <p>This is a useful pilot outcome rather than an error. The raw dimensions remain available below.</p>
            </div>`;
          document.querySelector('#portrait-text').textContent =
            'Within the Cognitive & Learning pilot, your current combination did not produce a clear higher-order PRECEPTA candidate under the provisional core rules.';
        } else {
          container.innerHTML = latestDerivation.map(renderPatternCard).join('');

          const clauses = latestDerivation.slice(0, 3)
            .map((p) => p.portrait_clause)
            .filter(Boolean);

          const names = latestDerivation.slice(0, 3).map((p) => p.name);
          const lead = names.length === 1
            ? `Your current Cognitive & Learning profile most clearly aligns with ${names[0]}.`
            : `Your current Cognitive & Learning profile is best described by the combination of ${names.slice(0, -1).join(', ')} and ${names[names.length - 1]}.`;

          const synthesis = clauses.length
            ? ` Taken together, this suggests that ${clauses.join(' At the same time, ')}`
            : '';

          document.querySelector('#portrait-text').textContent = lead + synthesis;
        }

        renderRawScores(scores);
      }

      form.addEventListener('submit', (event) => {
        event.preventDefault();

        const finalStep = steps[steps.length - 1];
        const missing = unansweredInputs(finalStep);
        if (missing.length) {
          finalStep.querySelector('[data-error]').hidden = false;
          finalStep.querySelector(`input[name="${CSS.escape(missing[0])}"]`)?.focus();
          return;
        }

        const scores = getScores();
        if (Object.keys(scores).length !== metadata.dimensionIds.length) {
          const firstIncomplete = steps.findIndex((step) => unansweredInputs(step).length);
          if (firstIncomplete >= 0) showStep(firstIncomplete);
          return;
        }

        renderResults(scores);
        questionnaire.hidden = true;
        results.hidden = false;
        window.location.hash = 'results';
        results.scrollIntoView({ behavior: 'smooth', block: 'start' });
      });

      document.querySelector('#change-answers').addEventListener('click', () => {
        results.hidden = true;
        questionnaire.hidden = false;
        window.location.hash = 'questionnaire';
        questionnaire.scrollIntoView({ behavior: 'smooth', block: 'start' });
      });

      function selectedValue(name) {
        return document.querySelector(`input[name="${CSS.escape(name)}"]:checked`)?.value ?? null;
      }

      function getMissingFeedback() {
        const gate = selectedValue('important_part_missing');
        const selectedPatterns = Array.from(
          document.querySelectorAll('input[name="missing_pattern"]:checked')
        ).map((input) => input.value);

        const followups = selectedPatterns.flatMap((patternId) => {
          const question = metadata.followups.questions.find((q) => q.pattern_id === patternId);
          if (!question) return [];
          const response = selectedValue(`followup_${question.question_id}`);
          return response ? [{
            pattern_id: patternId,
            question_id: question.question_id,
            response,
          }] : [];
        });

        return {
          important_part_missing: gate,
          selected_patterns: selectedPatterns,
          followups,
        };
      }

      function patternRecognitionFeedback() {
        return latestDerivation.flatMap((pattern) => {
          const response = selectedValue(`fit_${pattern.id}`);
          return response ? [{ pattern_id: pattern.id, response }] : [];
        });
      }

      function buildDownloadPayload() {
        return {
          schema: 'dynamos-cognitive-precepta-pilot',
          schema_version: '1.1.0',
          generated_at: new Date().toISOString(),
          model_version: metadata.modelVersion,
          questionnaire_version: metadata.questionnaireVersion,
          derivation_version: metadata.derivation.derivation_version,
          privacy_mode: 'local_only_no_transmission',
          scores: getScores(),
          derived_precepta: latestDerivation.map((p, index) => ({
            id: p.id,
            name: p.name,
            strength: p.inference_status === 'context_sensitive' ? 'context_sensitive' : p.strength,
            rank: index + 1,
          })),
          participant_feedback: {
            overall_precepta_fit: selectedValue('overall_precepta_fit'),
            pattern_recognition: patternRecognitionFeedback(),
            missing_pattern_feedback: getMissingFeedback(),
          },
          note: 'Experimental Cognitive & Learning PRECEPTA pilot. Not diagnostic and not a validated psychometric result.',
        };
      }

      function randomHex(bytes = 32) {
        const a = new Uint8Array(bytes);
        crypto.getRandomValues(a);
        return Array.from(a, (b) => b.toString(16).padStart(2, '0')).join('');
      }

      async function sha256Hex(value) {
        const data = new TextEncoder().encode(value);
        const digest = await crypto.subtle.digest('SHA-256', data);
        return Array.from(new Uint8Array(digest), (b) => b.toString(16).padStart(2, '0')).join('');
      }

      let donationSecrets = null;

      async function buildResearchContribution() {
        if (!donationSecrets) {
          donationSecrets = {
            submissionId: crypto.randomUUID(),
            withdrawalToken: randomHex(32),
          };
        }

        const withdrawalHash = await sha256Hex(donationSecrets.withdrawalToken);

        return {
          schema: 'dynamos-research-contribution',
          schema_version: '1.0.0',
          submission_id: donationSecrets.submissionId,
          withdrawal_token_hash: withdrawalHash,
          model_version: metadata.modelVersion,
          questionnaire_version: metadata.questionnaireVersion,
          derivation_version: metadata.derivation.derivation_version,
          consent_version: '0.1',
          scope: ['cognitive_learning'],
          scores: getScores(),
          presented_precepta: latestDerivation.map((p, index) => ({
            pattern_id: p.id,
            presentation_status: p.inference_status === 'context_sensitive' ? 'context_sensitive' : p.strength,
            rank: index + 1,
          })),
          participant_feedback: {
            overall_fit: selectedValue('overall_precepta_fit'),
            pattern_recognition: patternRecognitionFeedback(),
            missing_pattern_feedback: getMissingFeedback(),
          },
          consent: {
            voluntary_contribution: document.querySelector('input[name="consent_voluntary"]').checked,
            understands_exploratory_status: document.querySelector('input[name="consent_exploratory"]').checked,
            understands_no_identity_requested: document.querySelector('input[name="consent_no_identity"]').checked,
            understands_aggregate_publication: document.querySelector('input[name="consent_aggregate"]').checked,
            understands_withdrawal_token: document.querySelector('input[name="consent_withdrawal"]').checked,
          },
        };
      }

      function allConsentChecked() {
        return [
          'consent_voluntary',
          'consent_exploratory',
          'consent_no_identity',
          'consent_aggregate',
          'consent_withdrawal',
        ].every((name) => document.querySelector(`input[name="${name}"]`).checked);
      }

      document.querySelector('#download-json').addEventListener('click', () => {
        const payload = buildDownloadPayload();
        const blob = new Blob([JSON.stringify(payload, null, 2)], { type: 'application/json' });
        const url = URL.createObjectURL(blob);
        const a = document.createElement('a');
        a.href = url;
        a.download = `dynamos-cognitive-precepta-pilot-${metadata.modelVersion}.json`;
        document.body.appendChild(a);
        a.click();
        a.remove();
        URL.revokeObjectURL(url);
      });


      function renderMissingPatternChoices() {
        const presented = new Set(latestDerivation.map((p) => p.id));
        const allCognitive = metadata.derivation.patterns;
        const available = allCognitive.filter((p) => !presented.has(p.id));
        const list = document.querySelector('#missing-pattern-list');

        list.innerHTML = available.map((pattern) => `
          <label class="missing-choice">
            <input type="checkbox" name="missing_pattern" value="${pattern.id}" />
            <span>
              <strong>${pattern.name}</strong>
              <small>${pattern.description}</small>
            </span>
          </label>
        `).join('');
      }

      document.querySelectorAll('input[name="important_part_missing"]').forEach((input) => {
        input.addEventListener('change', () => {
          const panel = document.querySelector('#missing-pattern-panel');
          panel.hidden = input.value !== 'yes';
          if (input.value === 'yes') renderMissingPatternChoices();
          if (input.value !== 'yes') {
            document.querySelector('#missing-pattern-list').innerHTML = '';
            document.querySelector('#missing-followups').innerHTML = '';
          }
        });
      });

      document.querySelector('#missing-pattern-list').addEventListener('change', (event) => {
        if (!event.target.matches('input[name="missing_pattern"]')) return;

        const checked = Array.from(document.querySelectorAll('input[name="missing_pattern"]:checked'));
        if (checked.length > 3) {
          event.target.checked = false;
          return;
        }

        const selected = new Set(checked.map((input) => input.value));
        const followupContainer = document.querySelector('#missing-followups');

        followupContainer.innerHTML = metadata.followups.questions
          .filter((q) => selected.has(q.pattern_id))
          .map((q) => {
            const pattern = metadata.derivation.patterns.find((p) => p.id === q.pattern_id);
            return `
              <article class="followup-card">
                <p class="eyebrow">Optional targeted follow-up · ${pattern?.name ?? q.pattern_id}</p>
                <p><strong>${q.prompt}</strong></p>
                <div class="dimension-fit-options">
                  ${[
                    ['strongly_agree', 'Strongly agree'],
                    ['mostly_agree', 'Mostly agree'],
                    ['partly_agree', 'Partly agree'],
                    ['disagree', 'Disagree'],
                    ['unsure', 'Unsure'],
                  ].map(([value, label]) =>
                    `<label><input type="radio" name="followup_${q.question_id}" value="${value}" /><span>${label}</span></label>`
                  ).join('')}
                </div>
                <p class="small-note">This answer will not change the result above. It is stored separately as evidence about a possible measurement gap.</p>
              </article>
            `;
          }).join('');
      });

      document.querySelector('#prepare-donation').addEventListener('click', async () => {
        const status = document.querySelector('#donation-status');
        const preview = document.querySelector('#donation-preview');

        if (!allConsentChecked()) {
          status.textContent = 'Please tick all five consent statements before preparing a donation.';
          return;
        }

        const contribution = await buildResearchContribution();
        preview.textContent = JSON.stringify(contribution, null, 2);
        status.textContent = 'Donation record prepared locally. Nothing has been sent.';
      });

      document.querySelector('#print-results').addEventListener('click', () => window.print());

      updateProgress();
    </script>

