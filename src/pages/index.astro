---
import '../styles/global.css';
import model from '../../model/dynamos-v2.json';
import dimensions from '../../model/dimensions.json';
import precepta from '../../model/precepta.json';
import researchBackend from '../../model/research/backend.json';

const rawBase = import.meta.env.BASE_URL;
const base = rawBase.endsWith('/') ? rawBase : `${rawBase}/`;

const dimensionCount = dimensions.categories.reduce(
  (total, category) => total + category.dimensions.length,
  0
);

const preceptaCount = precepta.domains.reduce(
  (total, domain) => total + domain.patterns.length,
  0
);

const researchConfig = {
  apiBase: (researchBackend.api_base ?? '').replace(/\/$/, ''),
  modelVersion: model.version,
  questionnaireVersion: '1.1.0-pilot',
  derivationVersion: '0.3.0-pilot',
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta
      name="description"
      content="DYNAMOS — an open systems-architecture framework for understanding how human systems operate under meaning, load, interaction, context, and time."
    />
    <title>DYNAMOS — Dynamic Neuro-Operational Systems Model</title>
    <link rel="canonical" href="https://eebyak.github.io/DYNAMOS/" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="DYNAMOS" />
    <meta property="og:title" content="DYNAMOS — How does a human system operate?" />
    <meta
      property="og:description"
      content="DYNAMOS is an open, non-diagnostic systems-architecture framework for describing cognitive and behavioral dynamics under meaning, load, interaction, context, and time."
    />
    <meta property="og:url" content="https://eebyak.github.io/DYNAMOS/" />
    <meta
      property="og:image"
      content="https://eebyak.github.io/DYNAMOS/social/dynamos-link-preview.png"
    />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="627" />
    <meta
      property="og:image:alt"
      content="DYNAMOS — How does a human system operate?"
    />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content="DYNAMOS — How does a human system operate?" />
    <meta
      name="twitter:description"
      content="DYNAMOS is an open, non-diagnostic systems-architecture framework for describing cognitive and behavioral dynamics under meaning, load, interaction, context, and time."
    />
    <meta
      name="twitter:image"
      content="https://eebyak.github.io/DYNAMOS/social/dynamos-link-preview.png"
    />

  </head>

  <body>
    <header class="site-header">
      <a class="wordmark" href={base}>DYNAMOS</a>
      <nav aria-label="Primary navigation">
        <a href={`${base}model/`}>Model</a>
        <a href={`${base}precepta/`}>PRECEPTA</a>
        <a href={`${base}explore/`}>Explore</a>
        <a href={`${base}research/`}>Research</a>
        <a href={`${base}faq/`}>FAQ</a>
        <a href={`${base}responsible-use/`}>Responsible use</a>
      </nav>
    </header>

    <main>
      <section class="hero">
        <p class="eyebrow">Dynamic Neuro-Operational Systems Model · v{model.version}</p>
        <h1>How does a human system operate?</h1>
        <p class="lede">
          DYNAMOS is a non-diagnostic systems-architecture framework for describing
          cognitive and behavioral dynamics under meaning, load, interaction,
          context, and time.
        </p>

        <div class="boundary">
          <strong>Not a personality test. Not a diagnosis. Not a performance evaluation.</strong>
          <span>DYNAMOS describes operating architecture rather than categories of people.</span>
          <a class="boundary-link" href={`${base}responsible-use/`}>Read the responsible-use statement →</a>
        </div>

        <div class="stats" aria-label="Model summary">
          <div><strong>{dimensionCount}</strong><span>dimensions</span></div>
          <div><strong>{dimensions.categories.length}</strong><span>architectural categories</span></div>
          <div><strong>{preceptaCount}</strong><span>PRECEPTA patterns</span></div>
        </div>
      </section>


      <section id="research" class="section research-home">
        <div class="research-home-copy">
          <p class="eyebrow">Open research · live pilot</p>
          <h2>Help us find where the model works — and where it doesn’t.</h2>
          <p class="research-home-lede">
            DYNAMOS becomes more useful when people test its higher-order PRECEPTA
            interpretation against their own experience. Agreement helps. Disagreement
            is just as valuable.
          </p>
          <div class="research-actions">
            <a class="research-primary" href={`${base}explore/`}>Donate your data to research →</a>
            <a class="text-link" href={`${base}research/`}>See the live research status →</a>
          </div>
          <p class="research-note">
            Your questionnaire is calculated locally first. Nothing is contributed until
            you explicitly choose to donate the structured research record.
          </p>
        </div>

        <div class="research-live" aria-live="polite">
          <p class="eyebrow">Current evidence</p>
          <div class="research-stat-grid">
            <div><strong id="home-profile-count">—</strong><span>contributed profiles</span></div>
            <div><strong id="home-judgment-count">—</strong><span>PRECEPTA judgments</span></div>
            <div><strong>0.3</strong><span>current derivation pilot</span></div>
          </div>
          <p id="home-research-status" class="research-status">Loading live research status…</p>
        </div>
      </section>

      <section id="model" class="section">
        <div class="section-heading">
          <p class="eyebrow">The origin space</p>
          <h2>{dimensionCount} dimensions, not labels</h2>
          <p>
            Each dimension is continuous. No single dimension defines a person,
            trait, or PRECEPTA pattern. Meaning comes from configurations,
            context, interaction, and time.
          </p>
          <p><a class="text-link" href={`${base}model/`}>Explore all {dimensionCount} dimensions →</a></p>
        </div>

        <div class="category-grid">
          {dimensions.categories.map((category) => (
            <article class="card">
              <h3>{category.name}</h3>
              <p>{category.description}</p>
              <div class="chips">
                {category.dimensions.map((dimension) => (
                  <a href={`${base}model/${dimension.id}/`} title={dimension.name}>{dimension.id}</a>
                ))}
              </div>
            </article>
          ))}
        </div>
      </section>

      <section id="precepta" class="section contrast">
        <div class="section-heading">
          <p class="eyebrow">Phenotypic interface layer</p>
          <h2>PRECEPTA makes combinations readable</h2>
          <p>
            PRECEPTA translates combinations of DYNAMOS dimensions into
            human-readable, stigma-free patterns. It is an interface layer,
            not a diagnostic layer.
          </p>
        </div>

        <div class="domain-list">
          {precepta.domains.map((domain) => (
            <a class="domain-row domain-row-link" href={`${base}precepta/#${domain.id}`}>
              <span>{domain.name}</span>
              <strong>{domain.patterns.length} →</strong>
            </a>
          ))}
                  <p><a class="text-link" href={`${base}precepta/`}>Explore all {preceptaCount} PRECEPTA patterns →</a></p>
        </div>
      </section>

      <section id="principles" class="section">
        <div class="section-heading">
          <p class="eyebrow">Interpretation constraints</p>
          <h2>The model is open. Its claims are bounded.</h2>
        </div>

        <ol class="principles">
          {model.principles.map((principle) => <li>{principle}</li>)}
        </ol>
      </section>

      <section id="open" class="section open-section">
        <div>
          <p class="eyebrow">Open framework</p>
          <h2>Inspect it. Question it. Adapt it.</h2>
        </div>
        <div>
          <p>
            The canonical DYNAMOS specification is maintained as machine-readable
            JSON in the repository. Documentation and the website are derived from
            that model rather than acting as competing definitions.
          </p>
          <p>
            Model and content: <strong>CC BY-SA 4.0</strong><br />
            Software implementation: <strong>GPL-3.0-only</strong>
          </p>
        </div>
      </section>
    </main>

    <footer>
      <div>
        <p>
          <strong>DYNAMOS — Dynamic Neuro-Operational Systems Model</strong><br />
          © {model.copyright.year} {model.copyright.holder}
        </p>
        <p>
          Except where otherwise noted, DYNAMOS model content is licensed under
          CC BY-SA 4.0.
        </p>
      </div>

      <div class="footer-notice">
        <p>
          <strong>Responsible use:</strong> DYNAMOS is non-diagnostic and is not
          medical, psychological, legal, employment, or other professional advice.
        </p>
        <p><a href={`${base}responsible-use/`}>Read the full responsible-use and liability statement →</a></p>
      </div>
    </footer>

    <script
      type="application/json"
      id="research-home-config"
      set:html={JSON.stringify(researchConfig)}
    ></script>

    <script>
      const researchHomeConfig = JSON.parse(
        document.querySelector('#research-home-config').textContent
      );

      async function loadHomeResearchStats() {
        const status = document.querySelector('#home-research-status');

        if (!researchHomeConfig.apiBase) {
          status.textContent = 'Research collection is not connected yet.';
          return;
        }

        const params = new URLSearchParams({
          model_version: researchHomeConfig.modelVersion,
          questionnaire_version: researchHomeConfig.questionnaireVersion,
          derivation_version: researchHomeConfig.derivationVersion,
        });

        try {
          const response = await fetch(
            `${researchHomeConfig.apiBase}/v1/stats?${params.toString()}`,
            { headers: { accept: 'application/json' } }
          );

          if (!response.ok) throw new Error(`HTTP ${response.status}`);
          const stats = await response.json();

          document.querySelector('#home-profile-count').textContent =
            Number(stats.total_contributions ?? 0).toLocaleString();
          document.querySelector('#home-judgment-count').textContent =
            Number(stats.total_pattern_judgments ?? 0).toLocaleString();

          status.textContent =
            Number(stats.total_contributions ?? 0) === 0
              ? 'The pilot is ready for its first contributed profile.'
              : 'Live aggregate counts from the current DYNAMOS research cohort.';
        } catch {
          status.textContent =
            'Live research statistics are temporarily unavailable. The model and questionnaire still work normally.';
        }
      }

      loadHomeResearchStats();
    </script>

  <style>

      .research-home {
        display: grid;
        grid-template-columns: 1.15fr 0.85fr;
        gap: 4rem;
        align-items: start;
        border-top: 1px solid #b9b6ad;
        border-bottom: 1px solid #b9b6ad;
      }

      .research-home-lede { max-width: 760px; font-size: 1.15rem; }

      .research-actions {
        display: flex;
        align-items: center;
        gap: 1rem 1.5rem;
        flex-wrap: wrap;
        margin-top: 2rem;
      }

      .research-primary {
        display: inline-block;
        padding: 0.8rem 1rem;
        border: 1px solid #17202a;
        border-radius: 0.55rem;
        background: #17202a;
        color: #f7f5ef;
        text-decoration: none;
        font-weight: 750;
      }

      .research-note,
      .research-status { max-width: 700px; margin-top: 1.25rem; font-size: 0.88rem; }

      .research-live {
        border: 1px solid #b9b6ad;
        border-radius: 0.8rem;
        padding: 1.5rem;
      }

      .research-stat-grid {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        border-top: 1px solid #d2cfc6;
        border-bottom: 1px solid #d2cfc6;
      }

      .research-stat-grid div { display: grid; padding: 1.25rem 0.75rem 1.25rem 0; }
      .research-stat-grid strong { font-size: clamp(1.8rem, 4vw, 3rem); line-height: 1; }
      .research-stat-grid span { margin-top: 0.45rem; font-size: 0.78rem; }

      @media (max-width: 800px) {
        .research-home { grid-template-columns: 1fr; }
        .research-stat-grid { grid-template-columns: 1fr; }
        .research-stat-grid div + div { border-top: 1px solid #d2cfc6; }
      }

      .domain-row-link {
        text-decoration: none;
        transition: padding-left 140ms ease, padding-right 140ms ease, background-color 140ms ease;
      }
      .domain-row-link:hover,
      .domain-row-link:focus-visible {
        background: rgba(23, 32, 42, 0.045);
        padding-left: 0.5rem;
        padding-right: 0.5rem;
        outline: none;
      }
    </style>
  </body>
</html>
