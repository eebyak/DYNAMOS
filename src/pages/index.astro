---
import '../styles/global.css';
import model from '../../model/dynamos-v2.json';
import dimensions from '../../model/dimensions.json';
import precepta from '../../model/precepta.json';

const base = import.meta.env.BASE_URL;

const dimensionCount = dimensions.categories.reduce(
  (total, category) => total + category.dimensions.length,
  0
);

const preceptaCount = precepta.domains.reduce(
  (total, domain) => total + domain.patterns.length,
  0
);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta
      name="description"
      content="DYNAMOS — an open systems-architecture framework for understanding how human systems operate under meaning, load, interaction, context, and time."
    />
    <title>DYNAMOS — Dynamic Neuro-Operational Systems Model</title>
  </head>

  <body>
    <header class="site-header">
      <a class="wordmark" href={base}>DYNAMOS</a>
      <nav aria-label="Primary navigation">
        <a href={`${base}model/`}>Model</a>
        <a href={`${base}precepta/`}>PRECEPTA</a>
        <a href="#principles">Principles</a>
        <a href="#open">Open framework</a>
        <a href={`${base}responsible-use/`}>Responsible use</a>
      </nav>
    </header>

    <main>
      <section class="hero">
        <p class="eyebrow">Dynamic Neuro-Operational Systems Model · v{model.version}</p>
        <h1>How does a human system operate?</h1>
        <p class="lede">
          DYNAMOS is a non-diagnostic systems-architecture framework for describing
          cognitive and behavioral dynamics under meaning, load, interaction,
          context, and time.
        </p>

        <div class="boundary">
          <strong>Not a personality test. Not a diagnosis. Not a performance evaluation.</strong>
          <span>DYNAMOS describes operating architecture rather than categories of people.</span>
          <a class="boundary-link" href={`${base}responsible-use/`}>Read the responsible-use statement →</a>
        </div>

        <div class="stats" aria-label="Model summary">
          <div><strong>{dimensionCount}</strong><span>dimensions</span></div>
          <div><strong>{dimensions.categories.length}</strong><span>architectural categories</span></div>
          <div><strong>{preceptaCount}</strong><span>PRECEPTA patterns</span></div>
        </div>
      </section>

      <section id="model" class="section">
        <div class="section-heading">
          <p class="eyebrow">The origin space</p>
          <h2>{dimensionCount} dimensions, not labels</h2>
          <p>
            Each dimension is continuous. No single dimension defines a person,
            trait, or PRECEPTA pattern. Meaning comes from configurations,
            context, interaction, and time.
          </p>
          <p><a class="text-link" href={`${base}model/`}>Explore all {dimensionCount} dimensions →</a></p>
        </div>

        <div class="category-grid">
          {dimensions.categories.map((category) => (
            <article class="card">
              <h3>{category.name}</h3>
              <p>{category.description}</p>
              <div class="chips">
                {category.dimensions.map((dimension) => (
                  <a href={`${base}model/${dimension.id}/`} title={dimension.name}>{dimension.id}</a>
                ))}
              </div>
            </article>
          ))}
        </div>
      </section>

      <section id="precepta" class="section contrast">
        <div class="section-heading">
          <p class="eyebrow">Phenotypic interface layer</p>
          <h2>PRECEPTA makes combinations readable</h2>
          <p>
            PRECEPTA translates combinations of DYNAMOS dimensions into
            human-readable, stigma-free patterns. It is an interface layer,
            not a diagnostic layer.
          </p>
        </div>

        <div class="domain-list">
          {precepta.domains.map((domain) => (
            <a class="domain-row domain-row-link" href={`${base}precepta/#${domain.id}`}>
              <span>{domain.name}</span>
              <strong>{domain.patterns.length} →</strong>
            </a>
          ))}
                  <p><a class="text-link" href={`${base}precepta/`}>Explore all {preceptaCount} PRECEPTA patterns →</a></p>
        </div>
      </section>

      <section id="principles" class="section">
        <div class="section-heading">
          <p class="eyebrow">Interpretation constraints</p>
          <h2>The model is open. Its claims are bounded.</h2>
        </div>

        <ol class="principles">
          {model.principles.map((principle) => <li>{principle}</li>)}
        </ol>
      </section>

      <section id="open" class="section open-section">
        <div>
          <p class="eyebrow">Open framework</p>
          <h2>Inspect it. Question it. Adapt it.</h2>
        </div>
        <div>
          <p>
            The canonical DYNAMOS specification is maintained as machine-readable
            JSON in the repository. Documentation and the website are derived from
            that model rather than acting as competing definitions.
          </p>
          <p>
            Model and content: <strong>CC BY-SA 4.0</strong><br />
            Software implementation: <strong>GPL-3.0-only</strong>
          </p>
        </div>
      </section>
    </main>

    <footer>
      <div>
        <p>
          <strong>DYNAMOS — Dynamic Neuro-Operational Systems Model</strong><br />
          © {model.copyright.year} {model.copyright.holder}
        </p>
        <p>
          Except where otherwise noted, DYNAMOS model content is licensed under
          CC BY-SA 4.0.
        </p>
      </div>

      <div class="footer-notice">
        <p>
          <strong>Responsible use:</strong> DYNAMOS is non-diagnostic and is not
          medical, psychological, legal, employment, or other professional advice.
        </p>
        <p><a href={`${base}responsible-use/`}>Read the full responsible-use and liability statement →</a></p>
      </div>
    </footer>
  <style>
      .domain-row-link {
        text-decoration: none;
        transition: padding-left 140ms ease, padding-right 140ms ease, background-color 140ms ease;
      }
      .domain-row-link:hover,
      .domain-row-link:focus-visible {
        background: rgba(23, 32, 42, 0.045);
        padding-left: 0.5rem;
        padding-right: 0.5rem;
        outline: none;
      }
    </style>
  </body>
</html>
