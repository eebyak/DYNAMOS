---
import '../../styles/global.css';
import model from '../../../model/dynamos-v2.json';
import dimensions from '../../../model/dimensions.json';

export function getStaticPaths() {
  return dimensions.categories.flatMap((category) =>
    category.dimensions.map((dimension) => ({
      params: { id: dimension.id },
      props: {
        dimension,
        category: {
          id: category.id,
          name: category.name,
          description: category.description,
        },
        siblings: category.dimensions.map(({ id, name }) => ({ id, name })),
      },
    }))
  );
}

const { dimension, category, siblings } = Astro.props;
const rawBase = import.meta.env.BASE_URL;
const base = rawBase.endsWith('/') ? rawBase : `${rawBase}/`;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta
      name="description"
      content={`${dimension.id} — ${dimension.name}: ${dimension.short}. A canonical DYNAMOS v2 dimension.`}
    />
    <title>{dimension.id} — {dimension.name} | DYNAMOS</title>
  </head>

  <body>
    <header class="site-header">
      <a class="wordmark" href={base}>DYNAMOS</a>
      <nav aria-label="Primary navigation">
        <a href={`${base}model/`}>Model</a>
        <a href={`${base}precepta/`}>PRECEPTA</a>
        <a href={`${base}responsible-use/`}>Responsible use</a>
      </nav>
    </header>

    <main>
      <section class="dimension-hero">
        <div class="dimension-breadcrumb">
          <a href={`${base}model/`}>Model</a>
          <span>→</span>
          <a href={`${base}model/#${category.id}`}>{category.name}</a>
        </div>
        <div class="dimension-title-row">
          <div class="dimension-badge">{dimension.id}</div>
          <div>
            <p class="eyebrow">{category.name}</p>
            <h1>{dimension.name}</h1>
          </div>
        </div>
        <p class="lede">{dimension.short}</p>
      </section>

      <section class="dimension-body">
        <article class="dimension-definition">
          <p class="eyebrow">Canonical definition</p>
          <p class="definition-text">{dimension.description}</p>

          <div class="interpretation-warning">
            <strong>Interpret in configuration.</strong>
            <p>
              This dimension does not define a trait or person by itself. Its meaning
              depends on other DYNAMOS dimensions, context, interaction, and time.
            </p>
          </div>
        </article>

        <aside class="dimension-scale">
          <p class="eyebrow">Reflective scale</p>
          {Object.entries(model.scoring.scale.anchors).map(([range, label]) => (
            <div class="scale-row">
              <strong>{range}</strong>
              <span>{label}</span>
            </div>
          ))}
          <p class="small-note">
            Scores indicate magnitude or tendency, not desirability, diagnosis, or performance.
          </p>
        </aside>
      </section>

      <section class="siblings-section">
        <p class="eyebrow">Also in {category.name}</p>
        <div class="siblings-grid">
          {siblings.map((sibling) => (
            <a
              class:list={['sibling-link', { active: sibling.id === dimension.id }]}
              href={`${base}model/${sibling.id}/`}
              aria-current={sibling.id === dimension.id ? 'page' : undefined}
            >
              <span>{sibling.id}</span>
              <strong>{sibling.name}</strong>
            </a>
          ))}
        </div>
      </section>
    </main>

    <footer>
      <div>
        <p>
          <strong>DYNAMOS — Dynamic Neuro-Operational Systems Model</strong><br />
          © {model.copyright.year} {model.copyright.holder}
        </p>
        <p>Model and content licensed under CC BY-SA 4.0.</p>
      </div>
      <div class="footer-notice">
        <p><strong>Responsible use:</strong> DYNAMOS is non-diagnostic and is not a performance evaluation.</p>
        <p><a href={`${base}responsible-use/`}>Responsible-use statement →</a></p>
      </div>
    </footer>
  </body>
</html>
