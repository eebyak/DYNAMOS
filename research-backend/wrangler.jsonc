{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "dynamos-research",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-25",
  "vars": {
    "ALLOWED_ORIGINS": "https://eebyak.github.io,http://localhost:4321",
    "PUBLIC_SUPPRESSION_THRESHOLD": "20"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "dynamos-research",
      "database_id": "REPLACE_WITH_D1_DATABASE_ID"
    }
  ]
}
